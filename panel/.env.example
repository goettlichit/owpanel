APP_NAME=OWPanel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The panel database is MariaDB (E-006). For a quick local start, SQLite
# works as well: DB_CONNECTION=sqlite and remove the other DB_ lines.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=owpanel
DB_USERNAME=owpanel
DB_PASSWORD=

SESSION_DRIVER=database
# Sessions are encrypted, expire after 60 minutes without activity and use
# secure cookies only (docs/SICHERHEIT.md, "Anmeldung am Panel").
# Browsers accept secure cookies on http://localhost, e.g. through an SSH tunnel.
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue jobs live in the panel database, no Redis (E-052).
QUEUE_CONNECTION=database
# Must stay longer than the longest server task, see config/queue.php.
DB_QUEUE_RETRY_AFTER=3900

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="panel@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Shown in the footer together with the link to the source code.
# Time zone for times shown in the interface; the database stores UTC.
OWPANEL_TIMEZONE=Europe/Berlin

OWPANEL_VERSION=dev
OWPANEL_SOURCE_URL=https://github.com/goettlichit/owpanel
# Project homepage with the documentation, linked from the footer (E-109).
# OWPANEL_HOMEPAGE_URL=https://owpanel.org

# Private SSH key of the panel, outside the web root. Default:
# storage/app/private/ssh/id_ed25519, created by `php artisan owpanel:ssh-key`.
# OWPANEL_SSH_PRIVATE_KEY=
