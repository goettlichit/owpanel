#!/usr/bin/env bash
# Lists the restic snapshots of one website (E-096), newest first.
# Read-only; the result line carries one JSON object per snapshot.
#
#   site-backups --user ow38217
set -euo pipefail

# shellcheck source=server/lib/common.sh
source /opt/owpanel/lib/common.sh
# shellcheck source=server/lib/site.sh
source /opt/owpanel/lib/site.sh
# shellcheck source=server/lib/backup.sh
source /opt/owpanel/lib/backup.sh

usage() {
  owp_die "invalid_arguments" "usage: site-backups --user <owNNNNN>"
}

main() {
  local user="" php
  owp_init "site-backups"
  [[ $# -eq 2 && "$1" == "--user" ]] || usage
  user="$2"
  owp_valid_site_user "$user" || owp_die "invalid_user" "invalid site user"
  owp_reserved_site_user "$user" && owp_die "reserved_user" "${user} belongs to the panel"
  owp_require_root
  owp_require_backup
  php="$(command -v php || true)"
  [[ -n "$php" ]] || owp_die "php_missing" "php is needed to read the snapshot list"

  owp_tmpdir
  owp_restic snapshots --json --no-lock --tag "site:${user}" >"${OWP_TMPDIR}/snapshots.json" 2>"${OWP_TMPDIR}/restic.err" \
    || owp_die "list_failed" "$(tail -n 1 "${OWP_TMPDIR}/restic.err")"

  owp_result_ok "\"snapshots\":$("$php" -n "${OWP_ROOT}/lib/backup-list.php" <"${OWP_TMPDIR}/snapshots.json")"
}

main "$@"
