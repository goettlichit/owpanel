#!/usr/bin/env bash
# Reports the update state of the server for the panel (E-076): pending
# updates (security updates counted apart), the last runs that installed
# packages, whether automatic updates are on and whether a reboot is
# needed. It only reads: apt-get runs as a simulation without the apt
# lock, so it neither waits for nor disturbs unattended-upgrades.
#
#   server-updates
set -euo pipefail

# shellcheck source=server/lib/common.sh
source /opt/owpanel/lib/common.sh

# Sources read by this script. Tests point them to fixtures; sudo drops them.
OWP_UPDATES_SIMULATION="${OWP_UPDATES_SIMULATION:-}"
OWP_UPDATES_HISTORY="${OWP_UPDATES_HISTORY:-/var/log/apt/history.log}"
OWP_UPDATES_STAMPS="${OWP_UPDATES_STAMPS:-/var/lib/apt/periodic}"
OWP_APT_LISTS="${OWP_APT_LISTS:-/var/lib/apt/lists}"
OWP_STATUS_REBOOT_FILE="${OWP_STATUS_REBOOT_FILE:-/run/reboot-required}"

readonly MAX_PACKAGES=200
readonly MAX_RUNS=10
readonly MAX_RUN_PACKAGES=40

# Output of "apt-get -s dist-upgrade": one "Inst" line per package.
simulate_upgrade() {
  if [[ -n "$OWP_UPDATES_SIMULATION" ]]; then
    cat "$OWP_UPDATES_SIMULATION"
  else
    apt-get --simulate --quiet --option Debug::NoLocking=true dist-upgrade 2>/dev/null
  fi
}

# Turns "Inst" lines into the JSON fields pending, security and packages.
# Names and versions that do not look like Debian ones are skipped, so
# nothing unexpected reaches the JSON.
pending_json() {
  awk -v max="$MAX_PACKAGES" '
    $1 == "Inst" {
      name = $2; old = ""; new = ""
      if ($3 ~ /^\[/) { old = $3; gsub(/[][]/, "", old); new = $4 } else { new = $3 }
      sub(/^\(/, "", new)
      if (name !~ /^[a-z0-9][a-z0-9.+-]*$/ || new !~ /^[A-Za-z0-9.+~:-]+$/) next
      if (old != "" && old !~ /^[A-Za-z0-9.+~:-]+$/) next
      security = ($0 ~ /-security/ || $0 ~ /Debian-Security/) ? "true" : "false"
      total++
      if (security == "true") secure++
      if (shown < max) {
        list = list (shown ? "," : "") sprintf("{\"name\":\"%s\",\"from\":\"%s\",\"to\":\"%s\",\"security\":%s}", name, old, new, security)
        shown++
      }
    }
    END { printf "\"pending\":%d,\"security\":%d,\"packages\":[%s]", total, secure, list }
  '
}

# The last runs from apt's history, newest first, as
# "<start date>|<automatic|manual>|<count>|<name name …>".
history_runs() {
  local files=()
  [[ ! -f "${OWP_UPDATES_HISTORY}.1" ]] || files+=("${OWP_UPDATES_HISTORY}.1")
  [[ ! -f "$OWP_UPDATES_HISTORY" ]] || files+=("$OWP_UPDATES_HISTORY")
  [[ ${#files[@]} -gt 0 ]] || return 0

  awk -v maxnames="$MAX_RUN_PACKAGES" '
    function flush() {
      if (start != "" && count > 0) print start "|" kind "|" count "|" names
      start = ""; kind = "manual"; count = 0; names = ""; shown = 0
    }
    /^Start-Date: / { flush(); start = $2 " " $3 }
    /^Commandline: / { if ($0 ~ /unattended-upgrade/) kind = "automatic" }
    /^(Upgrade|Install): / {
      line = $0
      sub(/^[A-Za-z]+: /, "", line)
      # Entries look like "openssl:amd64 (3.5.1-1, 3.5.4-1~deb13u1)".
      gsub(/\([^)]*\)/, "", line)
      n = split(line, entry, ",")
      for (i = 1; i <= n; i++) {
        pkg = entry[i]; gsub(/^ +| +$/, "", pkg); sub(/:.*/, "", pkg)
        if (pkg !~ /^[a-z0-9][a-z0-9.+-]*$/) continue
        count++
        if (shown < maxnames) { names = names (shown ? " " : "") pkg; shown++ }
      }
    }
    END { flush() }
  ' "${files[@]}" | tail -n "$MAX_RUNS" | tac
}

runs_json() {
  local first=1 start kind count names epoch name list
  printf '['
  while IFS='|' read -r start kind count names; do
    [[ "$start" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || continue
    [[ "$kind" =~ ^(automatic|manual)$ && "$count" =~ ^[0-9]+$ ]] || continue
    epoch="$(date -d "$start" +%s 2>/dev/null)" || continue
    list=""
    for name in $names; do
      list+="${list:+,}\"${name}\""
    done
    ((first)) || printf ','
    first=0
    printf '{"at":%s,"kind":"%s","count":%s,"packages":[%s]}' "$epoch" "$kind" "$count" "$list"
  done < <(history_runs)
  printf ']'
}

# Modification time of a stamp file as epoch seconds, or null.
stamp() {
  local file="${OWP_UPDATES_STAMPS}/$1"
  if [[ -f "$file" ]]; then
    stat -c %Y "$file"
  else
    printf 'null\n'
  fi
}

# When the package lists were last updated. apt.systemd.daily writes
# update-success-stamp only with APT::Periodic::Update-Package-Lists; Debian
# 13 often updates the lists without it, so the newest Release file counts
# as well.
lists_updated() {
  local stamp newest
  stamp="$(stamp update-success-stamp)"
  newest="$(find "$OWP_APT_LISTS" -maxdepth 1 -type f \( -name '*_InRelease' -o -name '*_Release' \) -printf '%T@\n' 2>/dev/null \
    | sort -n | tail -n 1 | cut -d. -f1)"
  if [[ "$stamp" == "null" || (-n "$newest" && "$newest" -gt "$stamp") ]]; then
    stamp="${newest:-null}"
  fi
  printf '%s\n' "$stamp"
}

# Whether unattended-upgrades runs daily (APT::Periodic::Unattended-Upgrade).
automatic_updates() {
  local value
  value="$(apt-config shell VALUE APT::Periodic::Unattended-Upgrade 2>/dev/null || true)"
  value="${value#VALUE=\'}"
  value="${value%\'}"
  if [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

# Packages that asked for a reboot, from /run/reboot-required.pkgs.
reboot_packages() {
  local list="" name
  [[ -f "${OWP_STATUS_REBOOT_FILE}.pkgs" ]] || { printf '[]'; return 0; }
  while read -r name; do
    [[ "$name" =~ ^[a-z0-9][a-z0-9.+-]*$ ]] || continue
    [[ ",${list}," != *",\"${name}\","* ]] || continue
    list+="${list:+,}\"${name}\""
  done < <(head -n 20 "${OWP_STATUS_REBOOT_FILE}.pkgs")
  printf '[%s]' "$list"
}

main() {
  local simulation pending kernel running reboot=false
  owp_init "server-updates"
  [[ $# -eq 0 ]] || owp_die "invalid_arguments" "usage: server-updates"

  simulation="$(simulate_upgrade)" || owp_die "apt_failed" "apt-get could not simulate the upgrade"
  pending="$(pending_json <<<"$simulation")"

  running="$(uname -r)"
  [[ "$running" =~ ^[A-Za-z0-9._+-]{1,64}$ ]] || running=""
  kernel="$(owp_pending_kernel)"
  ! owp_reboot_required || reboot=true

  owp_result_ok "$(printf '%s,"runs":%s,"lists_updated":%s,"upgraded":%s,"automatic":%s,"reboot":{"required":%s,"kernel_running":"%s","kernel_installed":"%s","packages":%s}' \
    "$pending" "$(runs_json)" "$(lists_updated)" "$(stamp upgrade-stamp)" \
    "$(automatic_updates)" "$reboot" "$running" "$kernel" "$(reboot_packages)")"
}

main "$@"
