#!/usr/bin/env bash
# Installs the server scripts of a release that the panel sends (E-167).
#
#   server-scripts-update --version 1.2.3 < signature-and-archive
#
# stdin: the armored signature (.sig), then owpanel-<version>.tar.gz.
set -euo pipefail

# A test build sends the single line "unsigned" instead of a signature; it
# is only taken where root allowed test builds on this server
# (/etc/owpanel/allow-unsigned, written by the installer of a test build).
# Everything else is checked against the release keys in
# /etc/owpanel/release-signers before anything is unpacked.
#
# Only server/ and VERSION of the archive are used: the new setup-agent
# replaces /opt/owpanel and the sudo rules and keeps the panel's key. Never
# an older release; the same version again is fine, so a run can be
# repeated.

# shellcheck source=server/lib/common.sh
source /opt/owpanel/lib/common.sh
# shellcheck source=server/lib/release.sh
source /opt/owpanel/lib/release.sh

OWP_SCRIPTS_UPDATE_DIR="${OWP_SCRIPTS_UPDATE_DIR:-/var/lib/owpanel/scripts-update}"
OWP_ALLOW_UNSIGNED_FILE="${OWP_ALLOW_UNSIGNED_FILE:-/etc/owpanel/allow-unsigned}"
OWP_INSTALLED_VERSION_FILE="${OWP_INSTALLED_VERSION_FILE:-/opt/owpanel/VERSION}"
# An archive with vendor/ and the built assets is about 30 MB.
readonly OWP_SCRIPTS_MAX_BYTES=536870912
readonly OWP_SIG_BEGIN="-----BEGIN SSH SIGNATURE-----"
readonly OWP_SIG_END="-----END SSH SIGNATURE-----"
readonly OWP_SIG_LINE_RE='^[A-Za-z0-9+/=]{1,76}$'

usage() {
  owp_die "invalid_arguments" "usage: server-scripts-update --version <version> < signature-and-archive"
}

# Reads the signature block from stdin into $1 and sets SIGNED. bash reads
# a pipe byte by byte, so the archive that follows stays in stdin.
read_signature() {
  local file="$1" line count=0
  IFS= read -r line || owp_die "invalid_input" "stdin is empty"
  if [[ "$line" == "unsigned" ]]; then
    SIGNED=0
    return 0
  fi
  [[ "$line" == "$OWP_SIG_BEGIN" ]] || owp_die "invalid_input" "stdin must start with a signature or \"unsigned\""
  printf '%s\n' "$line" >"$file"
  while IFS= read -r line; do
    count=$((count + 1))
    ((count <= 40)) || owp_die "invalid_input" "the signature is too long"
    if [[ "$line" == "$OWP_SIG_END" ]]; then
      printf '%s\n' "$line" >>"$file"
      SIGNED=1
      return 0
    fi
    [[ "$line" =~ $OWP_SIG_LINE_RE ]] || owp_die "invalid_input" "the signature contains an invalid line"
    printf '%s\n' "$line" >>"$file"
  done
  owp_die "invalid_input" "the signature does not end"
}

read_archive() {
  local file="$1" size
  head -c "$((OWP_SCRIPTS_MAX_BYTES + 1))" >"$file"
  size="$(stat -c %s "$file")"
  ((size > 0)) || owp_die "invalid_input" "the archive is missing"
  ((size <= OWP_SCRIPTS_MAX_BYTES)) || owp_die "invalid_input" "the archive is too large"
}

# Whether this server may install $1 over what it has now.
check_order() {
  local target="$1" installed=""
  [[ -f "$OWP_INSTALLED_VERSION_FILE" ]] && installed="$(head -c 64 "$OWP_INSTALLED_VERSION_FILE" | head -n 1)"
  [[ "$installed" =~ $OWP_VERSION_RE ]] || return 0
  owp_release_tagged "$installed" && owp_release_tagged "$target" || return 0
  [[ "$target" == "$installed" ]] && return 0
  owp_release_newer "$target" "$installed" || owp_die "not_newer" "${target} is older than the installed ${installed}"
}

update_scripts() {
  local version="$1" work archive source
  check_order "$version"

  install -d -o root -g root -m 0700 "$OWP_SCRIPTS_UPDATE_DIR"
  work="${OWP_SCRIPTS_UPDATE_DIR}/run"
  rm -rf -- "$work"
  install -d -o root -g root -m 0700 "$work"
  archive="${work}/owpanel-${version}.tar.gz"

  SIGNED=0
  read_signature "${archive}.sig"
  read_archive "$archive"

  if ((SIGNED == 1)); then
    owp_release_verify "$archive" || owp_die "invalid_signature" "the signature of the archive is not valid"
    owp_log "signature checked"
  else
    [[ "$version" == dev-* ]] || owp_die "signature_required" "a release must be signed"
    [[ -f "$OWP_ALLOW_UNSIGNED_FILE" && ! -L "$OWP_ALLOW_UNSIGNED_FILE" ]] \
      || owp_die "unsigned_not_allowed" "this server takes no test builds"
    owp_warn "installing the unsigned test build ${version}"
  fi

  # Only the parts this server needs, never paths outside the archive's
  # own folder (tar refuses absolute names and .. by default).
  tar -xzf "$archive" -C "$work" --no-same-owner --no-same-permissions \
    "owpanel-${version}/VERSION" "owpanel-${version}/server" 2>/dev/null \
    || owp_die "unpack_failed" "the archive does not contain the server scripts of ${version}"
  source="${work}/owpanel-${version}"
  [[ "$(head -c 64 "${source}/VERSION" | head -n 1)" == "$version" ]] \
    || owp_die "not_a_release" "the archive holds another version"
  [[ -f "${source}/server/provision/setup-agent" && -f "${source}/server/lib/common.sh" ]] \
    || owp_die "not_a_release" "the archive does not contain the server scripts"

  owp_log "installing the server scripts of ${version}"
  bash "${source}/server/provision/setup-agent" --keep-key >/dev/null \
    || owp_die "scripts_install_failed" "the new scripts could not be installed"
  rm -rf -- "$work"
  owp_log "server scripts ${version} installed"
  owp_result_ok "\"version\":\"${version}\",\"signed\":$( ((SIGNED == 1)) && echo true || echo false)"
}

main() {
  owp_init "server-scripts-update"
  [[ $# -eq 2 && "$1" == "--version" ]] || usage
  [[ "$2" =~ $OWP_VERSION_RE ]] || owp_die "invalid_version" "not a version: ${2}"
  owp_require_root
  owp_check_os
  owp_lock 300
  update_scripts "$2"
}

main "$@"
