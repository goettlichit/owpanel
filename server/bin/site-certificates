#!/usr/bin/env bash
# Lists the Let's Encrypt certificates of the websites and of the panel for
# the panel (E-076): name (the site user), domains and expiry, and whether
# certbot.timer renews them. It only reads.
#
#   site-certificates
set -euo pipefail

# shellcheck source=server/lib/common.sh
source /opt/owpanel/lib/common.sh
# shellcheck source=server/lib/site.sh
source /opt/owpanel/lib/site.sh

# Tests point this to fixtures; sudo drops it.
OWP_CERT_LIVE="${OWP_CERT_LIVE:-/etc/letsencrypt/live}"

readonly MAX_DOMAINS=20

# Domains of a certificate from its subjectAltName, as a JSON list.
domains_json() {
  local list="" domain count=0
  while read -r domain; do
    owp_valid_domain "$domain" || continue
    ((count < MAX_DOMAINS)) || break
    list+="${list:+,}\"${domain}\""
    count=$((count + 1))
  done < <(openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null \
    | grep -o 'DNS:[^,]*' | sed 's/^DNS://; s/ //g' || true)
  printf '[%s]' "$list"
}

certificates_json() {
  local first=1 dir name cert end expires
  printf '['
  for dir in "$OWP_CERT_LIVE"/ow*; do
    [[ -d "$dir" ]] || continue
    name="${dir##*/}"
    owp_valid_site_user "$name" || continue
    cert="${dir}/cert.pem"
    [[ -f "$cert" ]] || continue
    end="$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null)" || continue
    expires="$(date -d "${end#notAfter=}" +%s 2>/dev/null)" || continue
    [[ "$expires" =~ ^[0-9]+$ ]] || continue
    ((first)) || printf ','
    first=0
    printf '{"user":"%s","expires":%s,"domains":%s}' "$name" "$expires" "$(domains_json "$cert")"
  done
  printf ']'
}

main() {
  local timer=false
  owp_init "site-certificates"
  [[ $# -eq 0 ]] || owp_die "invalid_arguments" "usage: site-certificates"

  if systemctl is-active --quiet certbot.timer 2>/dev/null; then
    timer=true
  fi

  owp_result_ok "\"certificates\":$(certificates_json),\"renewal_timer\":${timer}"
}

main "$@"
