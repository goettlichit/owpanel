#!/usr/bin/env bash
# Turns SFTP access of a website on or off (E-089). The panel sends the whole
# state each time, so a second run with the same input changes nothing.
#
#   site-sftp --user ow38217 --state on  < credentials
#   site-sftp --user ow38217 --state off
#
# For "on", stdin holds at most one line "password<TAB><password>" and any
# number of lines "key<TAB><OpenSSH public key>". Without a password line the
# password is locked; without key lines no key works. Passwords and keys never
# appear as parameters.
#
# The website user logs in with SFTP only, locked into /var/www/<user> and
# starting in htdocs. The sshd drop-in comes from the sftp provision module.
set -euo pipefail

# shellcheck source=server/lib/common.sh
source /opt/owpanel/lib/common.sh
# shellcheck source=server/lib/site.sh
source /opt/owpanel/lib/site.sh

# Tests point these elsewhere; sudo drops them.
OWP_SFTP_KEYS_DIR="${OWP_SFTP_KEYS_DIR:-/etc/ssh/owpanel-sftp}"
OWP_SITES_ROOT="${OWP_SITES_ROOT:-/var/www}"
OWP_SSHD_DROPIN="${OWP_SSHD_DROPIN:-/etc/ssh/sshd_config.d/owpanel-sftp.conf}"

readonly MAX_KEYS=20
readonly MAX_KEY_LENGTH=8192
# Set when a password or key was replaced or removed.
CHANGED=0

readonly KEY_TYPES="ssh-ed25519 ssh-rsa ecdsa-sha2-nistp256 ecdsa-sha2-nistp384 ecdsa-sha2-nistp521 sk-ssh-ed25519@openssh.com sk-ecdsa-sha2-nistp256@openssh.com"

usage() {
  owp_die "invalid_arguments" "usage: site-sftp --user <owNNNNN> --state <on|off> < credentials"
}

# Printable ASCII without spaces, as generated by the panel.
valid_password() {
  [[ ${#1} -ge 12 && ${#1} -le 128 && "$1" =~ ^[!-~]+$ ]]
}

# "type base64 [comment]" without options in front; ssh-keygen confirms that
# the key itself can be parsed.
valid_key() {
  local key="$1" type blob comment
  [[ ${#key} -le $MAX_KEY_LENGTH && ! "$key" =~ [[:cntrl:]] ]] || return 1
  read -r type blob comment <<<"$key"
  [[ " ${KEY_TYPES} " == *" ${type} "* ]] || return 1
  [[ "$blob" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || return 1
  [[ -z "$comment" || "$comment" =~ ^[[:print:]]+$ ]] || return 1
  printf '%s %s\n' "$type" "$blob" | ssh-keygen -l -f /dev/stdin >/dev/null 2>&1
}

in_group() {
  id -nG "$1" | tr ' ' '\n' | grep -qxF "$OWP_SFTP_GROUP"
}

# Ends running SFTP sessions after access was taken away or changed. The
# session processes run as the website user; PHP-FPM is not touched.
end_sessions() {
  if pkill --uid "$1" --exact 'sshd|sshd-session' 2>/dev/null; then
    owp_log "ended open SFTP sessions"
  fi
}

# Compares a password with the stored hash. Both go through stdin, so they
# do not show up in the process list; perl's crypt uses the system library.
password_matches() {
  printf '%s\n%s\n' "$1" "$2" \
    | perl -e 'chomp(my $h = <STDIN>); chomp(my $p = <STDIN>); exit(length($h) > 2 && crypt($p, $h) eq $h ? 0 : 1)'
}

set_password() {
  local user="$1" password="$2" current
  current="$(getent shadow "$user" | cut -d: -f2)"
  if [[ -n "$password" ]]; then
    if password_matches "$current" "$password"; then
      owp_log "password unchanged"
      return 0
    fi
    # chpasswd reads user:password from stdin and hashes it like passwd.
    printf '%s:%s\n' "$user" "$password" | chpasswd
    CHANGED=1
    owp_log "password set"
  elif [[ "$current" != '!' ]]; then
    usermod --password '!' "$user"
    CHANGED=1
    owp_log "password locked"
  fi
}

write_keys() {
  local user="$1" tmp="$2"
  local file="${OWP_SFTP_KEYS_DIR}/${user}"
  [[ -d "$OWP_SFTP_KEYS_DIR" && ! -L "$OWP_SFTP_KEYS_DIR" ]] \
    || owp_die "sftp_not_installed" "${OWP_SFTP_KEYS_DIR} is missing; run the base setup of the server again"
  if [[ ! -s "$tmp" ]]; then
    if [[ -e "$file" ]]; then
      rm -f "$file"
      CHANGED=1
      owp_log "removed keys"
    fi
    return 0
  fi
  if [[ -f "$file" ]] && cmp -s "$tmp" "$file"; then
    owp_log "keys unchanged"
    return 0
  fi
  # sshd reads the file as the user; it must belong to root and not be
  # writable for the user, who must not add keys or options himself.
  install -o root -g "$user" -m 0640 "$tmp" "${file}.new"
  mv -f "${file}.new" "$file"
  CHANGED=1
  owp_log "keys updated"
}

turn_on() {
  local user="$1" root="$2" line kind value password="" keys=0 tmp
  [[ -f "$OWP_SSHD_DROPIN" ]] \
    || owp_die "sftp_not_installed" "the sshd drop-in is missing; run the base setup of the server again"
  getent group "$OWP_SFTP_GROUP" >/dev/null \
    || owp_die "sftp_not_installed" "group ${OWP_SFTP_GROUP} is missing; run the base setup of the server again"
  # sshd only chroots into a directory that belongs to root and is not
  # writable by anyone else; site-create sets it up like that.
  [[ -d "$root" && ! -L "$root" && "$(stat -c '%U %a' "$root")" == "root 750" ]] \
    || owp_die "unsafe_path" "${root} is not a valid chroot directory"

  owp_tmpdir
  tmp="${OWP_TMPDIR}/keys"
  : >"$tmp"
  while IFS= read -r -t 10 line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ "$line" == *$'\t'* ]] || owp_die "invalid_input" "line without tab"
    kind="${line%%$'\t'*}"
    value="${line#*$'\t'}"
    case "$kind" in
      password)
        [[ -z "$password" ]] || owp_die "invalid_input" "more than one password"
        valid_password "$value" || owp_die "invalid_password" "invalid password"
        password="$value"
        ;;
      key)
        valid_key "$value" || owp_die "invalid_ssh_key" "key $((keys + 1)) is not a valid public key"
        keys=$((keys + 1))
        ((keys <= MAX_KEYS)) || owp_die "too_many_ssh_keys" "at most ${MAX_KEYS} keys per website"
        # restrict turns off forwarding, PTY and rc files for the key as well.
        printf 'restrict %s\n' "$value" >>"$tmp"
        ;;
      *) owp_die "invalid_input" "unknown line type" ;;
    esac
  done

  set_password "$user" "$password"
  write_keys "$user" "$tmp"
  if ! in_group "$user"; then
    gpasswd --add "$user" "$OWP_SFTP_GROUP" >/dev/null
    owp_log "SFTP turned on"
  elif [[ "$CHANGED" -eq 1 ]]; then
    # A removed key or old password must not keep an open session alive.
    end_sessions "$user"
  fi
  owp_result_ok "\"enabled\":true,\"password\":$([[ -n "$password" ]] && echo true || echo false),\"keys\":${keys}"
}

turn_off() {
  local user="$1" empty
  owp_tmpdir
  empty="${OWP_TMPDIR}/none"
  : >"$empty"
  if in_group "$user"; then
    gpasswd --delete "$user" "$OWP_SFTP_GROUP" >/dev/null
    owp_log "SFTP turned off"
  fi
  set_password "$user" ""
  if [[ -d "$OWP_SFTP_KEYS_DIR" ]]; then
    write_keys "$user" "$empty"
  fi
  end_sessions "$user"
  owp_result_ok '"enabled":false'
}

main() {
  local user="" state=""
  owp_init "site-sftp"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user | --state)
        [[ $# -ge 2 ]] || usage
        [[ "$1" == "--user" ]] && user="$2" || state="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  owp_valid_site_user "$user" || owp_die "invalid_user" "invalid site user"
  owp_reserved_site_user "$user" && owp_die "reserved_user" "${user} belongs to the panel"
  [[ "$state" == "on" || "$state" == "off" ]] || usage
  getent passwd "$user" >/dev/null || owp_die "site_not_found" "website ${user} does not exist"

  owp_lock 60
  if [[ "$state" == "on" ]]; then
    turn_on "$user" "${OWP_SITES_ROOT}/${user}"
  else
    turn_off "$user"
  fi
}

main "$@"
