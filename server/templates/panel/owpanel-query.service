# Managed by OWPanel. Do not edit, changes are overwritten.
# Query worker of the panel (E-079): runs the SQL of the database tool while
# the user waits. Separate from owpanel-queue, so a query never waits behind
# a long server task. Runs as owpanel-worker, the only user that can read the
# panel's SSH key.
[Unit]
Description=OWPanel query worker for the database tool
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=owpanel-worker
Group=owpanel-worker
SupplementaryGroups=ow10000
WorkingDirectory=/var/www/ow10000/current/panel
Environment=LOG_PATH=/var/www/ow10000/shared/storage/logs/query.log
Environment=VIEW_COMPILED_PATH=/var/lib/owpanel-worker/views
ExecStart=/usr/bin/php artisan queue:work --queue=queries --tries=1 --sleep=1 --max-time=3600
Restart=always
RestartSec=5
UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/ow10000/shared/storage/logs /var/lib/owpanel-worker/views
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
