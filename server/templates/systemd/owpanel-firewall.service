# Managed by OWPanel. Do not edit, changes are overwritten.
# Loads the confirmed OWPanel firewall rules at boot (E-044).
[Unit]
Description=OWPanel firewall
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=nftables.service
Conflicts=shutdown.target
DefaultDependencies=no
ConditionPathExists=/etc/owpanel/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/owpanel/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/owpanel/firewall.nft

[Install]
WantedBy=sysinit.target
