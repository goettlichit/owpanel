# Managed by OWPanel. Do not edit, changes are overwritten.
# Loads the blocklists from the panel at boot (E-170).
[Unit]
Description=OWPanel blocklists
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=nftables.service owpanel-firewall.service
Conflicts=shutdown.target
DefaultDependencies=no
ConditionPathExists=/etc/owpanel/blocklist.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/owpanel/blocklist.nft
ExecReload=/usr/sbin/nft -f /etc/owpanel/blocklist.nft

[Install]
WantedBy=sysinit.target
